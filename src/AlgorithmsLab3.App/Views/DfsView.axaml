<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AlgorithmsLab3.App.ViewModels"
             xmlns:controls="using:AlgorithmsLab3.App.Controls"
             xmlns:sys="using:System"
             x:Class="AlgorithmsLab3.App.Views.DfsView"
             x:DataType="vm:DfsPageViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,18,24,24" Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="ЧАСТЬ 3 · СТЕК" />
        <TextBlock Classes="page-title" Text="Итеративный обход графа в глубину" />
        <TextBlock Classes="muted" MaxWidth="1050"
                   Text="DFS реализован без рекурсии: собственный стек хранит вершины для посещения. Вершина извлекается из стека, помечается посещённой, а её непосещённые соседи кладутся в стек. Сложность O(V + E)." />
      </StackPanel>

      <StackPanel Spacing="16">

        <StackPanel Spacing="16">
          <Border Classes="panel" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="ГРАФ" />
              <TextBlock Classes="app-title" Text="Список рёбер" />
              <TextBlock Classes="muted" Text="По одному ребру в строке: 1 2 или 1-2. Одиночное число добавляет изолированную вершину." />
              <TextBox Text="{Binding EdgesText}" Classes="mono" Height="220"
                       AcceptsReturn="True" TextWrapping="NoWrap"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section" Text="СТАРТОВАЯ ВЕРШИНА" Margin="0" />
                  <TextBox Text="{Binding StartText}" Classes="mono" Watermark="Стартовая вершина" />
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding Directed}" Content="Ориентированный"
                          VerticalAlignment="Bottom" />
              </Grid>

              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Classes="primary" Content="Запустить DFS" Command="{Binding RunDfsCommand}" />
                <Button Classes="ghost" Content="Случайный граф" Command="{Binding RandomGraphCommand}" />
                <Button Classes="ghost" Content="Пример" Command="{Binding LoadSampleCommand}" />
              </WrapPanel>

              <TextBlock Classes="muted" Text="{Binding Status}" />
              <TextBlock Classes="muted" Text="{Binding GraphInfo}" />
            </StackPanel>
          </Border>

          <Border Classes="panel" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="ПОРЯДОК ОБХОДА" />
              <TextBlock Classes="big-value" Text="{Binding VisitOrderText}" />
              <TextBlock Classes="muted" Text="{Binding Stats}" />

              <TextBlock Classes="section" Text="ЖУРНАЛ СТЕКА" Margin="0,8,0,0" />
              <ScrollViewer Height="230" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Trace}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                      <Border Classes="log-row">
                        <TextBlock Text="{Binding}" Classes="mono" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Classes="panel" Padding="16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
              <TextBlock Classes="section" Text="ЛЕГЕНДА" />
              <TextBlock Classes="muted"
                         Text="Жёлтая рамка — стартовая вершина, зелёные вершины посещены, рядом указан номер посещения. Серые вершины недостижимы из выбранного старта." />
            </StackPanel>
            <controls:GraphCanvas MinHeight="560" Visualization="{Binding Visualization}" />
          </DockPanel>
        </Border>

      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
