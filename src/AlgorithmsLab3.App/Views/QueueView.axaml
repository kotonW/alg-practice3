<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AlgorithmsLab3.App.ViewModels"
             xmlns:exec="using:AlgorithmsLab3.Domain.Execution"
             xmlns:bench="using:AlgorithmsLab3.Domain.Benchmarks"
             x:Class="AlgorithmsLab3.App.Views.QueueView"
             x:DataType="vm:QueuePageViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,18,24,24" Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="ЧАСТЬ 2 · ОЧЕРЕДЬ" />
        <TextBlock Classes="page-title" Text="Своя очередь против стандартного Queue&lt;T&gt;" />
        <TextBlock Classes="muted" MaxWidth="1050"
                   Text="Команды: 1 — вставка (значение после запятой), 2 — удаление, 3 — просмотр начала, 4 — проверка на пустоту, 5 — печать. Один и тот же набор выполняется двумя реализациями, результаты сравниваются автоматически." />
      </StackPanel>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="КОМАНДЫ ОЧЕРЕДИ" />
          <TextBlock Classes="app-title" Text="input.txt" />
          <TextBox Text="{Binding CommandInput}" Classes="mono" Height="130"
                   AcceptsReturn="True" TextWrapping="NoWrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Classes="primary" Content="Выполнить в двух реализациях"
                    Command="{Binding RunCommandsCommand}" />
            <Button Classes="ghost" Content="Открыть файл…" Click="LoadFileClick" />
            <Button Classes="ghost" Content="Пример" Command="{Binding LoadSampleCommand}" />
            <Button Classes="ghost" Content="Случайный набор" Command="{Binding GenerateRandomCommand}" />
          </WrapPanel>

          <TextBlock Classes="muted" Text="{Binding Status}" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="card">
              <StackPanel Spacing="5">
                <TextBlock Classes="section" Text="СВОЙ СВЯЗНЫЙ СПИСОК" />
                <TextBlock Classes="value" Text="{Binding LinkedSummary}" />
                <TextBlock Classes="mono" Text="{Binding LinkedFinal}" TextWrapping="Wrap" MaxHeight="90" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="5">
                <TextBlock Classes="section" Text="СТАНДАРТНЫЙ QUEUE&lt;T&gt;" />
                <TextBlock Classes="value" Text="{Binding StandardSummary}" />
                <TextBlock Classes="mono" Text="{Binding StandardFinal}" TextWrapping="Wrap" MaxHeight="90" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card" Background="{DynamicResource AppAccentSoftBrush}">
            <TextBlock Classes="value" Text="{Binding MatchText}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="ПООПЕРАЦИОННОЕ СРАВНЕНИЕ" />
          <Grid ColumnDefinitions="40,100,*,*,36" Margin="8,2,8,4">
            <TextBlock Classes="section" Text="#" Margin="0" />
            <TextBlock Grid.Column="1" Classes="section" Text="КОМАНДА" Margin="0" />
            <TextBlock Grid.Column="2" Classes="section" Text="СВЯЗНЫЙ СПИСОК" Margin="0" />
            <TextBlock Grid.Column="3" Classes="section" Text="QUEUE&lt;T&gt;" Margin="0" />
            <TextBlock Grid.Column="4" Classes="section" Text="=" Margin="0" />
          </Grid>
          <ScrollViewer Height="330" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ComparisonLog}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="exec:QueueComparisonEntry">
                  <Border Classes="log-row">
                    <Grid ColumnDefinitions="40,100,*,*,36">
                      <TextBlock Text="{Binding Index}" Classes="muted" />
                      <TextBlock Grid.Column="1" Text="{Binding Command}" Classes="mono" />
                      <TextBlock Grid.Column="2" Text="{Binding LinkedResult}" Classes="info" />
                      <TextBlock Grid.Column="3" Text="{Binding StandardResult}" Classes="info" />
                      <TextBlock Grid.Column="4" Text="{Binding Mark}" Classes="good" FontWeight="Bold" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="section" Text="ЗАМЕРЫ ВРЕМЕНИ" />
              <TextBlock Classes="app-title" Text="Разная длина и одинаковая длина с разным составом" />
              <TextBlock Classes="muted" MaxWidth="900"
                         Text="Чтение файла и выполнение измеряются для каждой реализации отдельно. Три набора по 20 000 операций имеют одинаковую длину, но разный состав: только вставки, вставки/удаления и вставки с частой печатью." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Classes="primary" Content="Запустить замеры"
                      Command="{Binding RunBenchmarksCommand}" />
              <Button Classes="ghost" Content="Экспорт CSV" Click="ExportBenchmarksClick" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="muted" Text="{Binding BenchmarkStatus}" />

          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel MinWidth="930" Spacing="0">
              <Grid ColumnDefinitions="1.8*,1.1*,75,100,100,75,80,55" Margin="8,4,8,2">
                <TextBlock Classes="section" Text="НАБОР" Margin="0" />
                <TextBlock Grid.Column="1" Classes="section" Text="ГРУППА" Margin="0" />
                <TextBlock Grid.Column="2" Classes="section" Text="ОПЕРАЦИЙ" Margin="0" />
                <TextBlock Grid.Column="3" Classes="section" Text="СПИСОК, ИТОГО" Margin="0" />
                <TextBlock Grid.Column="4" Classes="section" Text="QUEUE, ИТОГО" Margin="0" />
                <TextBlock Grid.Column="5" Classes="section" Text="ОТНОШЕНИЕ" Margin="0" />
                <TextBlock Grid.Column="6" Classes="section" Text="РАЗНИЦА" Margin="0" />
                <TextBlock Grid.Column="7" Classes="section" Text="ВЫВОД" Margin="0" />
              </Grid>

              <ItemsControl ItemsSource="{Binding BenchmarkRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="bench:QueueBenchmarkRow">
                    <Border Classes="log-row">
                      <Grid ColumnDefinitions="1.8*,1.1*,75,100,100,75,80,55">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" Classes="value" />
                          <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Group}" Classes="muted" />
                        <TextBlock Grid.Column="2" Text="{Binding Operations}" Classes="mono" />
                        <TextBlock Grid.Column="3" Text="{Binding LinkedTotalMilliseconds, StringFormat={}{0:F3} мс}" Classes="mono" />
                        <TextBlock Grid.Column="4" Text="{Binding StandardTotalMilliseconds, StringFormat={}{0:F3} мс}" Classes="mono" />
                        <TextBlock Grid.Column="5" Text="{Binding Ratio, StringFormat={}{0:F2}×}" Classes="mono" />
                        <TextBlock Grid.Column="6" Text="{Binding DifferencePercent, StringFormat={}{0:F1} %}" Classes="mono" />
                        <TextBlock Grid.Column="7" Text="{Binding MatchText}" Classes="muted" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
